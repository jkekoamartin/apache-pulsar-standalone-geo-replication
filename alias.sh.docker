#!/bin/sh

# pulsar-admin alias
alias alpha-admin='docker exec -it alpha bin/pulsar-admin'
alias beta-admin='docker exec -it beta bin/pulsar-admin'
alias gamma-admin='docker exec -it gamma bin/pulsar-admin'

# pulsar-client alias
alias alpha-client='docker exec -it alpha bin/pulsar-client'
alias beta-client='docker exec -it beta bin/pulsar-client'
alias gamma-client='docker exec -it gamma bin/pulsar-client'